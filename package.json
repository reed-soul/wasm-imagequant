{
  "name": "wasm-imagequant",
  "version": "0.1.4",
  "description": "High-performance perceptual color quantization and PNG compressor in WebAssembly (Rust)",
  "type": "module",
  "scripts": {
    "dev": "serve .",
    "build": "wasm-pack build --target web --release",
    "test": "cargo test",
    "bench": "cargo run --release --example compare",
    "bench:photos": "cargo run --release --example test_user_photos"
  },
  "devDependencies": {
    "serve": "^14.2.4"
  },
  "keywords": [
    "wasm",
    "webassembly",
    "imagequant",
    "pngquant",
    "image-compression",
    "quantization",
    "oklab"
  ],
  "author": "reed-soul",
  "license": "MIT OR Apache-2.0"
}
